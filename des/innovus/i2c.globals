###############################################################
#  Innovus Import Globals - i2c_master_top
#  Load this in: File -> Import Design -> Load
###############################################################

set defHierChar {/}
set init_verilog {top.v}
set init_top_cell {top}
set init_io_file {top.io}
set init_mmmc_file {mmmc.view}
set init_pwr_net {VDD VDDC VDDO}
set init_gnd_net {VSS VSSC VSSO}
set init_assign_buffer {1}
set init_import_mode { -keepEmptyModule 0 -treatUndefinedCellAsBbox 0}
set delaycal_input_transition_delay {120ps}
set conf_in_tran_delay {120.0ps}
set conf_ioOri {R0}
set init_abstract_view {abstract}
set init_layout_view {layout}
set init_lef_file {/users/iit/cadence/tsl018b/lef/tsl18_6lm_tech.lef /users/iit/cadence/tsl018b/lef/tsl18fs120.lef /tools/kits/tower/TS18SL_6_01/tsl18pio320sl_Rev_2021.11/lib/lef/stack/PIO320SL_6M1L.lef}

# Uniquify hierarchy: pad modules (pc3d01, pt3o01 etc.) are used
# multiple times. Without this Innovus flags everything as dont-touch
# blocks and placement sees 0 std cells.
set init_design_uniquify 1
set load_netlist_ignore_undefined_cell 1
set init_verilog_tolerate_port_mismatch 0
set ::TimeLib::tsgMarkCellLatchConstructFlag 1
set timing_enable_default_delay_arc 1
